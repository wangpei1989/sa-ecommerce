<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== 南非区域配置 ==================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 位置权限（用于物流追踪、自提点推荐） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- 存储权限（用于商品图片缓存） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    
    <!-- 相机权限（用于商品拍摄、身份证认证） -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- 短信权限（用于OTP验证） -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    
    <!-- 支付相关 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- NFC（用于物流扫描） -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- 蓝牙（用于近场支付/物流设备） -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <application
        android:name=".SACommerceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SACommerce"
        android:usesCleartextTraffic="false"
        android:localeConfig="@xml/locales_config"
        
        <!-- 南非区域优化 -->
        android:enableOnBackInvokedCallback="true"
        
        tools:targetApi="tiramisu">

        <!-- 主Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- 深度链接配置 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="sacomerce.co.za"
                    android:pathPrefix="/app" />
            </intent-filter>
            
            <!-- App Links验证 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="sacomerce"
                    android:host="app" />
            </intent-filter>
        </activity>

        <!-- 支付回调Activity -->
        <activity
            android:name=".payment.PaymentCallbackActivity"
            android:exported="true"
            android:theme="@style/Theme.SACommerce.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="sacomerce"
                    android:host="payment" />
            </intent-filter>
        </activity>

        <!-- 分享Activity -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:theme="@style/Theme.SACommerce">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- ==================== 服务 ==================== -->
        <service
            android:name=".service.OrderSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- ==================== 接收器 ==================== -->
        <receiver
            android:name=".receiver.SMSReceiver"
            android:exported="false"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ==================== 内容提供者 ==================== -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- ==================== 支付SDK配置 ==================== -->
        <!-- PayStack -->
        <meta-data
            android:name="com.paystack.sdk.PublicKey"
            android:value="${PAYSTACK_PUBLIC_KEY}" />

        <!-- Ozow -->
        <meta-data
            android:name="com.ozow.SiteCode"
            android:value="${OZOW_SITE_CODE}" />

        <!-- ==================== App Links配置 ==================== -->
        <property
            android:name="android.support.PARENT_ACTIVITY"
            android:value="" />

    </application>

    <!-- 南非区域queries配置 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

</manifest>
